PORT=4000
NODE_ENV=development

# JWT Secrets
JWT_SECRET=your_super_secret_key_here_at_least_32_characters_long
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_DAYS=14
JWT_ISSUER=mahfudh-academy-api
JWT_AUDIENCE=mahfudh-academy-client
JWT_REFRESH_AUDIENCE=mahfudh-academy-refresh

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mahfudh_academy

# Supabase Storage (Production)
# Create bucket named 'mahfudh-uploads' and make it public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=mahfudh-uploads

# CORS - CRITICAL for production!
# Set to your Vercel frontend URL (comma-separated for multiple origins)
# Example: CLIENT_ORIGIN=https://mahfudhacademy.vercel.app,https://custom-domain.com
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

BASE_URL=http://localhost:4000
AUTH_MODE=bearer
LOG_LEVEL=info
GOOGLE_CLIENT_ID=

LOGIN_MAX_FAILURES=6
LOGIN_LOCK_MINUTES=15
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MIN_INTERVAL_SECONDS=60
REGISTRATION_VERIFICATION_EXPIRES_MINUTES=15
OTP_DEV_LOG_CODE=0

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SOCKET_BAN_MINUTES=15
CHAT_RESTRICT_THRESHOLD=3
CHAT_RESTRICT_MINUTES=1440
SECURITY_LOCKOUT_RETENTION_DAYS=30
SECURITY_AUDIT_RETENTION_DAYS=90
SECURITY_BAN_RETENTION_DAYS=30
SECURITY_RESTRICTION_RETENTION_DAYS=30
SECURITY_CLEANUP_INTERVAL_MS=21600000

SMOKE_API_BASE=http://localhost:4000
SMOKE_OWNER_EMAIL=owner@example.com
SMOKE_OWNER_PASSWORD=replace_me
SMOKE_OTP_CODE=
SMOKE_GOOGLE_ID_TOKEN=
SMOKE_RUN_PHONE_OTP=0
SMOKE_PHONE_NUMBER=

SFU_PROVIDER=livekit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
